# Public configuration only. Never add private keys here.
ADMIN_ADDRESS=
SIGNER_ADDRESS=
TREASURY_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
# 32-byte opaque campaign identifier, 0x-prefixed.
CAMPAIGN_ID=
# UTC Unix seconds, start must be in the future.
SALE_START=
SALE_END=
SOFT_CAP_CENTS=1000000
HARD_CAP_CENTS=5000000
# All PHOOD quantities below are smallest units (18 decimals).
PHOOD_TOTAL_SUPPLY_UNITS=
IDO_ALLOCATION_UNITS=
# E.g. 100 PHOOD per $1 => 100000000000000000000; must be divisible by 100.
TOKEN_UNITS_PER_DOLLAR=
